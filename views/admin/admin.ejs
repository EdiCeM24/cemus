<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
  </head>
  <body>
    <header><%- include('partials/header.ejs') %></header>
    <div class="flex h-screen overflow-hidden">
      <div class="flex h-screen overflow-hidden">
        <!-- Sidebar Navigation -->
        <%- include('partials/sidebar.ejs') %>

        <!-- Main Right Container Area -->
        <div class="flex flex-col flex-1 overflow-y-auto overflow-x-hidden">
          <!-- Navbar -->
          <%- include('partials/header.ejs') %>

          <!-- Dynamic Page Body Injection -->
          <main
            class="flex-1 flex-col p-4 md:p-8 overflow-y-auto sm:overflow-scroll"
          >
            <%- include('partials/main.ejs') %>
            <div class="mt-5 p-3">
              <%- include('partials/activities.ejs') %>
            </div>
            <div class="mt-5 p-3"><%- include('partials/users.ejs') %></div>
            <div class="mt-5 p-3"><%- include('partials/msg.ejs') %></div>
            <div class="mt-5 p-3"><%- include('partials/settings.ejs') %></div>
            <div class="mt-5 p-3">
              <%- include('partials/aboutModel.ejs') %>
            </div>
          </main>
        </div>
      </div>
    </div>

    
    <div class="">
      <!-- // Check if there is a success message -->
      <% if (success_msg && success_msg.length > 0) { %>
        Swal.fire({
          icon: 'success',
          title: 'Success!',
          text: '<%= success_msg %>',
          timer: 3000
        });
      <% } %>

      <!-- // Check if there is an error message -->
      <% if (error_msg && error_msg.length > 0) { %>
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: '<%= error_msg %>'
        });
      <% } %>
    </div>
    <footer><%- include('../partials/footer.ejs') %></footer>
    <!-- Load Chart.js from official CDN -->
    <script src="https://jsdelivr.net"></script>
    <!-- <script src="/script/admin.js"></script> -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="sweetalert2.min.js"></script>
    <!-- SweetAlert Flash Handler Logic --> 
  </body>
</html>

 <!-- 
  Inject chart scripts safely into the bottom of layouts/main.ejs 
  using the express-ejs-layouts script  block.
-->
    
<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Revenue Line Chart Configuration
    const ctxRevenue = document
      .getElementById("revenueChart")
      .getContext("2d");
    new Chart(ctxRevenue, {
      type: "line",
      data: {
        labels: [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec",
        ],
        datasets: [
          {
            label: "Monthly Revenue ($)",
            data: serverRevenue,
            borderColor: "#4f46e5", // Tailwind indigo-600
            backgroundColor: "rgba(79, 70, 229, 0.05)",
            fill: true,
            tension: 0.35, // Smooth curves
            borderWidth: 3,
            pointRadius: 2,
            pointHoverRadius: 6,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }, // Text descriptors handled in HTML UI
          tooltip: { padding: 12, cornerRadius: 8 },
        },
        scales: {
          y: {
            grid: { color: "#f1f5f9" }, // Tailwind slate-100
            ticks: {
              color: "#64748b", // Tailwind slate-500
              callback: (value) => "$" + value.toLocaleString(),
            },
          },
          x: {
            grid: { display: false },
            ticks: { color: "#64748b" },
          },
        },
      },
    });

    // 2. Traffic Acquisition Doughnut Chart Configuration
    const ctxTraffic = document
      .getElementById("trafficChart")
      .getContext("2d");
    new Chart(ctxTraffic, {
      type: "doughnut",
      data: {
        labels: ["Direct", "Organic Search", "Referrals"],
        datasets: [
          {
            data: serverTraffic,
            backgroundColor: [
              "#4f46e5", // Indigo-600
              "#0ea5e9", // Sky-500
              "#f59e0b", // Amber-500
            ],
            borderWidth: 4,
            borderColor: "#ffffff",
            hoverOffset: 4,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom",
            labels: { boxWidth: 12, padding: 20, color: "#475569" },
          },
          tooltip: { padding: 12, cornerRadius: 8 },
        },
      },
    });
  });
</script>
