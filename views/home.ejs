              </div>
            </div>


            <div class="glass rounded-3xl overflow-hidden hover:-translate-y-2 transition duration-300">
              <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1200&auto=format&fit=crop" class="h-56 w-full object-cover" />

              <div class="p-8">
                <h3 class="text-2xl font-bold mb-4">E-Commerce App</h3>
                <p class="text-slate-300 mb-6">
                  Full production ecommerce application with payments and authentication.
                </p>

                <button class="text-cyan-400 font-semibold hover:text-cyan-300">
                  View Project →
                </button>
              </div>
            </div>


            <div class="glass rounded-3xl overflow-hidden hover:-translate-y-2 transition duration-300">
              <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop" class="h-56 w-full object-cover" />

              <div class="p-8">
                <h3 class="text-2xl font-bold mb-4">AI Platform</h3>
                <p class="text-slate-300 mb-6">
                  AI powered productivity application with secure backend architecture.
                </p>

                <button class="text-cyan-400 font-semibold hover:text-cyan-300">
                  View Project →
                </button>
              </div>
            </div>

          </div>

        </div>
      </section>


      <!-- Contact -->
      <section id="contact" class="py-28 border-t border-slate-800 bg-slate-900/40">

        <div class="max-w-4xl mx-auto px-6 text-center">

          <h2 class="text-4xl lg:text-5xl font-extrabold mb-8">
            Let's Build Something <span class="gradient-text">Amazing</span>
          </h2>

          <p class="text-slate-300 text-lg mb-10">
            Ready to create scalable digital products and modern experiences.
          </p>

          <button id="contact-me" class="bg-cyan-500 hover:bg-cyan-400 transition px-10 py-5 rounded-full text-slate-950 font-bold shadow-xl shadow-cyan-500/30">
            Contact Me
          </button>

        </div>
      </section>
      

      
    </main>
    
   <script>
      // Use EJS output syntax to check if the message array contains elements
      // connect-flash returns an array, so check if length > 0
    </script>
    <% if (success_msg && success_msg.length > 0) { %>
        Toastify({
            text: "<%= success_msg %>",
            duration: 4000,
            gravity: "top", // top or bottom
            position: "right", // left, center or right
            style: {
                background: "linear-gradient(to right, #00b09b, #96c93d)",
            }
        }).showToast();
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
      Toastify({
        text: "<%= error_msg %>",
        duration: 4000,
        gravity: "top",
        position: "right",
        style: {
          background: "linear-gradient(to right, #ff5f6d, #ffc371)",
        }
      }).showToast();
    <% } %>
    <div class="">
      <!-- // Check if there is a success message -->
      <% if (success_msg && success_msg.length > 0) { %>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '<%= success_msg %>',
            timer: 3000
        });
      <% } %>

      <!-- // Check if there is an error message -->
      <% if (error_msg && error_msg.length > 0) { %>
        Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: '<%= error_msg %>'
        });
      <% } %>
    </div>
    <footer>
      <%- include('partials/footer.ejs') %>
    </footer>
    <script src="/script/app.js"></script>
    <script>
      const themeSelect = document.getElementById('theme-select');
      themeSelect.addEventListener('change', (e) => {
        const newTheme = e.target.value;
        document.documentElement.setAttribute('data-theme', newTheme)
      })
   </script>
   <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="sweetalert2.min.js"></script>
  </body>
</html>
