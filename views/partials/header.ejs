<!-- <script src="/script/dash.js"></script> -->
<script>
  // On page load, apply the saved theme or fall back to light
  const savedTheme = localStorage.getItem("theme") || "light";
  document.documentElement.setAttribute("data-theme", savedTheme);

  // Sync checkboxes or radios with the saved theme
  const themeControllers = document.querySelectorAll(".theme-controller");
  themeControllers.forEach((controller) => {
    if (controller.type === "checkbox" && savedTheme === "dark") {
      controller.checked = true;
    } else if (controller.type === "radio" && controller.value === savedTheme) {
      controller.checked = true;
    }

    // Listen for theme changes to update local storage
    controller.addEventListener("change", (e) => {
      const selectedTheme = e.target.value;

      // If it's a checkbox toggling light/dark
      if (e.target.type === "checkbox") {
        const theme = e.target.checked ? "dark" : "light";
        localStorage.setItem("theme", theme);
        document.documentElement.setAttribute("data-theme", theme);
      } else {
        // If it's a radio selection
        localStorage.setItem("theme", selectedTheme);
        document.documentElement.setAttribute("data-theme", selectedTheme);
      }
    });
  });
</script>




