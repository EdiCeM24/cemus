<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <title><%- title %></title>
    <link rel="stylesheet" href="/css/output.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@ionic/core/css/ionic.bundle.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css"
    />
  </head>

  <body class="font-[Arial] p-[30px] bg-[#f5f5f5]">
    <p class="mt-3 mb-4 text-2xl font-serif font-extrabold text-center">
      Feel free to navigate to a page of your choice.
    </p>
    <div
      class="container settings-contents mx-auto md:flex items-center justify-evenly gap-5 h-screen bg-white p-[30px] rounded-[10px]"
    >
      <a
        href="/api/v1/passwords/forgot"
        class="settings-mob bg-slate-950 py-2.5 px-3 text-lg rounded-md text-center text-gray-300 font-serif font-bold"
        >Change Password</a
      >
      <a
        href="/"
        class="settings-mob bg-slate-950 py-2.5 px-3 text-lg rounded-md text-center text-gray-300 font-serif font-bold"
        >Terms and Conditions</a
      >
      <a
        href="/"
        class="settings-mob bg-slate-950 py-2.5 px-3 text-lg rounded-md text-center text-gray-300 font-serif font-bold"
        >Privacy Policy</a
      >
      <a
        href=""
        class="settings-mob bg-slate-950 py-2.5 px-3 text-lg rounded-md text-center text-gray-300 font-serif font-bold"
        >Privacy Policy</a
      >
      <a
        href=""
        class="settings-mob bg-slate-950 py-2.5 px-3 text-lg rounded-md text-center text-gray-300 font-serif font-bold"
        >Privacy Policy</a
      >
    </div>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <footer><%- include('partials/footer.ejs') %></footer>

    <script>
      // Use EJS output syntax to check if the message array contains elements
      // connect-flash returns an array, so check if length > 0
    </script>
    <% if (success_msg && success_msg.length > 0) { %>
        Toastify({
            text: "<%= success_msg %>",
            duration: 4000,
            gravity: "top", // top or bottom
            position: "right", // left, center or right
            style: {
                background: "linear-gradient(to right, #00b09b, #96c93d)",
            }
        }).showToast();
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
        Toastify({
            text: "<%= error_msg %>",
            duration: 4000,
            gravity: "top",
            position: "right",
            style: {
                background: "linear-gradient(to right, #ff5f6d, #ffc371)",
            }
        }).showToast();
    <% } %>
  </body>
</html>
