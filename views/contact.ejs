<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%- include('partials/head.ejs') %>
</head>
<body class="">
  <!-- Navbar -->
  <navbar>
    <%- include('partials/navbar.ejs') %>
  </navbar>
  <main class="mt-[5%] py-5 px-5">

    <div class="mt-10">
      <div class="mt-[3%] px-32">
        <div class="md:flex items-center justify-center md:justify-evenly p-5">
          <div class="flex-1 lg:mt-10 md:mb-0 md:mt-[10%] mb-5">
            <img src="/images/cemus_by_car.jpg" class="lg:w-[80%] lg:h-[70%] w-full h-full rounded-sm" alt="Photo">
          </div>
          <div class="flex-1 mt-[-1%] pl-0">
            <div class="flex-1">
              <p class="text-white text-xl font-serif font-semibold mb-2">
                Lorem ipsum dolor sit amet consectetur adipisicing elit. Facere vero incidunt assumenda eligendi aliquam totam autem sapiente. Quidem iusto nisi, maxime, sed blanditiis magni aliquam officia quisquam consequuntur culpa itaque corrupti explicabo reprehenderit consectetur natus perferendis laboriosam dolorum odio voluptatibus.
              </p>
              <span class="flex items-center gap-x-10 mb-3">
                <a href="" class="bg-white w-8 h-8 flex items-center justify-center object-cover rounded-full border-2 border-sky-500 text-blue-700"><i class="fab fa-facebook-square text-2xl"></i></a>
                <a href="" class="bg-white w-8 h-8 flex items-center justify-center object-cover rounded-full border-2 border-sky-500 text-slate-700"><i class="fab fa-github-square text-2xl"></i></a>
                <a href="" class="bg-white w-8 h-8 flex items-center justify-center object-cover rounded-full border-2 border-sky-500 text-blue-700"><i class="fab fa-linkedin text-2xl"></i></a>
                <a href="" class="bg-white w-8 h-8 flex items-center justify-center object-cover rounded-full border-2 border-sky-500 text-slate-800"><i class="fas fa-times text-2xl"></i></a>
                <a href="" class="bg-white w-8 h-8 flex items-center justify-center object-cover rounded-full border-2 border-sky-500 text-rose-700"><i class="fab fa-youtube text-2xl"></i></a>
              </span>
              <span class="flex flex-col items-start justify-start">
                <span class="flex items-center justify-evenly gap-x-10">
                  <a href="+234 702 626 6495" class=""><i class="fas fa-phone text-2xl"></i></a>
                  <a href="mailto:xemars24@gmail.com" class=""><i class="fas fa-envelope text-2xl"></i></a>
                </span>
                <span class="text-xl text-sky-300 font-serif font-bold">
                  Let's ceate the <span class="gradient-text text-xl font-extrabold font-mono">projects</span> and maintain accurate time line.
                </span>
               </span>
            </div>
          
        </div>
      </div>

      <!-- FORM SECTION -->
      <section class="mt-5 mb-20 py-0 px-[20%]">
        <%- include('partials/contactForm.ejs') %>
      </section>
    </div>
  </main>



    
  
  <% if (success_msg && success_msg.length > 0) { %>
    Toastify({
      text: "<%= success_msg %>",
      duration: 4000,
      gravity: "top", // top or bottom
      position: "right", // left, center or right
      style: {
          background: "linear-gradient(to right, #00b09b, #96c93d)",
      }
    }).showToast();
  <% } %>

  <% if (error_msg && error_msg.length > 0) { %>
    Toastify({
      text: "<%= error_msg %>",
      duration: 4000,
      gravity: "top",
      position: "right",
      style: {
          background: "linear-gradient(to right, #ff5f6d, #ffc371)",
      }
    }).showToast();
  <% } %>

  <div class="mt-5">
      <!-- // Check if there is a success message -->
    <% if (success_msg && success_msg.length > 0) { %>
      Swal.fire({
        icon: 'success',
        title: 'Success!',
        text: '<%= success_msg %>',
        timer: 3000
      });
    <% } %>

    <!-- // Check if there is an error message -->
    <% if (error_msg && error_msg.length > 0) { %>
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: '<%= error_msg %>'
      });
    <% } %>
  </div>  

  <footer class="bg-slate-950">
    <%- include('partials/footer.ejs') %>
  </footer>
  <script src="/script/contact.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
      lucide.createIcons();
      // Use EJS output syntax to check if the message array contains elements
      // connect-flash returns an array, so check if length > 0
  </script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="sweetalert2.min.js"></script>
  <!-- SweetAlert Flash Handler Logic -->
</body>
</html>
