<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <%- include('partials/head.ejs') %>
</head>
<body class="overflow-y-scroll text-white p-0 m-0 relative bg-slate-950">
  <!-- Navbar -->
  <navbar>
    <%- include('partials/navbar.ejs') %>
  </navbar>


  <div class="p-5 mb-5 md:mt-[5%] container mx-auto bg-slate-950">
    <!--BOARD HEAD-->
    <div class="hero min-h-screen bg-base-200 md:mt-[5%] bg-slate-950">
      <div class="hero-content flex-col lg:flex-row-rever bg-slate-950">
        <div class="text-center lg:text-left mt-20">
          <h1 class="md:text-5xl md:font-extrabold text-lg">Get in Touch</h1>
          <p class="py-6 lg:text-2xl lg:whitespace-nowrap lg:font-semibold">I'd love to hear from you! Send me a message and I'll get back to you soon.</p>

          <span class="mt-4 flex items-center leading-snug justify-center flex-col flex-wrap">
              <span class="mt-3 text-[#3ae43a] md:text-xl md:font-semibold font-serif">Let's work together and create a stuning website.</span>
    
              <div class="md:flex flex-col items-center justify-evenly gap-5 mt-5">
                <div class="flex items-center justify-evenly space-x-2 mt-5 mb-3 p-2 border-l-4">
                  <a href="https://github.com/EdiCeM24" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-github"></i></a>
                  <a href="https://facebook.com/Saviour Marcus" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-facebook"></i></a>
                  <a href="https://linkedin.com/in/cletus-marcus" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-linkedin"></i></a>
                  <a href="https://x.com/Edicem24" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-twitter"></i></a>
                  <a href="https://youtube.com" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-youtube"></i></a>
                </div>
                    
                <form action="" class="md:right-10 left-[50%]" method="POST">
                  <!-- <input type="hidden" name="" id=""  /> -->
                  <div class="flex items-center justify-evenly gap-2 mb-2">
                    <img src="/images/cemus_by_car.jpg" class="w-[20%] h-[20%] rounded-full flex object-cover items-center justify-center" alt="">
                    <div class="flex-col p-2.5">
                      <p class="mb-2.5 md:whitespace-nowrap md:text-xl font-semibold">Let's ceate the <span class="gradient-text">Projects</span> in an engineering patterns:</p>
                      <ul class="gap-2">
                        <li><a href="" class="text-2xl">Project Time line</a></li>
                        <li><a href="" class="text-2xl">SRS</a></li>
                        <li><a href="" class="text-2xl">Scrum</a></li>
                      </ul>
                    </div>
                  </div>
                      
                </form>
             </div>
          </span>
        </div>
        <div class="card flex-shrink-0 w-full max-w-sm shadow-2xl bg-slate-950 p-6">
          <div class="card-body bg-slate-950">
            <div class="contact_form_containe transition-shadow place-content-center mb-3 bg-slate-950">
              <strong class="contact_form_heading flex text-center justify-center text-2xl font-serif font-semibold text-[#eee] mt-3 mb-3">Hire Me</strong>
              <!-- <i class="fa fa-times cursor-pointer text-xl font-bold flex items-center justify-center" aria-hidden="true" id="contact-form-cancel"></i> -->
              <div class="cont_form_container w-full flex items-center justify-center">
                  <form action="/api/v1/contacts/contact" method="POST" class="contact-form flex items-center justify-center py-4 px-6">
                    <!-- <input type="hidden" name="" value=""/> -->
                    <div class="contact_form_contents w-full items-center justify-center">
                      <div class="contact_form_control md:flex w-ful mt-3 mb-3 gap-4">
                        <input type="text" name="name" id="name" placeholder="Your full name" class="w-ful text-slate-800 text-xl font-semibold font-serif p-2 mb-3 px-3 border-none outline-none rounded-sm" required autocomplete="off" autofocus>
                        <input type="email" name="email" id="email" placeholder="Your Email" class="w-ful text-slate-800 text-xl font-semibold font-serif p-2 mt-1 px-3 border-none outline-none rounded-sm" required autocomplete="off" autofocus>
                      </div>
                      <div class="contact_form_control md:flex w-ful mt-3 mb-3 gap-4">
                        <input type="url" name="website" id="website" class="w-ful text-slate-800 text-xl font-semibold font-serif p-2 mb-3 px-3 border-none outline-none rounded-sm" placeholder="Your Website" required autocomplete="off" autofocus>
                        <input type="text" name="company" id="company" class="w-ful text-slate-800 text-xl font-semibold font-serif p-2 mt-1 px-3 border-none outline-none rounded-sm" placeholder="Your Company" required autocomplete="off" autofocus>
                      </div>
                      <div class="contact_form_control md:flex items-center justify-between w-ful mt-4 mb-4">
                        <input type="text" name="subject" id="subject" class="w-ful text-slate-800 text-xl font-semibold font-serif p-2 px-3 border-none outline-none rounded-sm" placeholder="Your Subject" required autocomplete="off" autofocus>
                        <span class="flex items-center justify-center gap-3 ml-1.5">
                          <span class="flex items-center justify-evenly gap-1">
                            <input type="radio" name="activity" value="freelance" id="freelance" required>
                            <label for="">Freelance</label>
                          </span>
                          <span class="flex items-center justify-evenly gap-1">
                            <input type="radio" name="activity" value="remote" id="remote" required>
                            <label for="">Remote</label>
                          </span>
                          <span class="flex items-center justify-evenly gap-1">
                              <input type="radio" name="activity" value="on_site" id="on_site" required>
                                <label for="">On_site</label>
                          </span>
                        </span>
                      </div>
                      <div class="contact_form_control md:flex items-center  gap-3 w-ful mt-4 mb-3">
                        <textarea name="message" id="message" class="w-ful text-slate-800 text-xl font-semibold font-serif p-2 px-3 border-none outline-none rounded-sm" cols="30" rows="4" placeholder="Your message" required autocomplete="off" autofocus></textarea>
                        <select name="service" id="budget" class="bg-sky-950 p-3 border-none outline-none " required>
                          <option>Weekly Budget</option>
                          <option value="1">$1000-1500</option>
                          <option value="2">$1500-2000</option>
                          <option value="3">$2000-2500</option>
                          <option value="4">$2500-3000</option>
                          <option value="5">$3000+</option>
                        </select>
                      </div>
            
                      <button type="submit" class="w-ful btn btn-primary cursor-pointer p-2 px-3 border-none outline-none rounded-sm bg-cyan-800 hover:bg-cyan-900 transition duration-200 ease-in-out">Contact Me</button>
                    </div>
                  </form>
                </div>
              </div>
            </div> 


            <div class="flex flex-col items-center justify-evenly mb-3 gap-5">
              <span class="flex items-center gap-1 px-1 border-l-2 border-l-indigo-800">
                <h1 class="flex text-center justify-center md:text-3xl text-lg font-semibold font-serif text-amber-300 mt-2 gap-1.5">Reach out <span class="text-3xl font-extrabold gradient-text">@</span>:</h1>
              </span>
              <div class="lg:flex items-center gap-3">
                <div class="flex items-center justify-center gap-2">
                  <i class="fa fa-envelope" aria-hidden="true"></i>
                  <a href="mailto:xemars24@gmail.com" class="md:text-xl text-[16px] text-white font-serif font-semibold">xemars24@gmail.com</a>
                </div>
                <div class="flex items-center justify-center gap-2">
                  <i class="fa fa-phone" aria-hidden="true"></i>
                  <span class="text-[16px] text-white font-serif font-semibold whitespace-nowrap">+234 (0) 702 626 6495</span>
                </div>
              </div>
            </div>
<i class="fa-solid fa-headphones"></i>
          </div>
        </div>
      </div>
    </div>
  </div>



    
  


  <footer class="bg-slate-950">
    <%- include('partials/footer.ejs') %>
  </footer>
  <script src="/script/contact.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <script>
      lucide.createIcons();
      // Use EJS output syntax to check if the message array contains elements
      // connect-flash returns an array, so check if length > 0
  </script>
    <% if (success_msg && success_msg.length > 0) { %>
        Toastify({
            text: "<%= success_msg %>",
            duration: 4000,
            gravity: "top", // top or bottom
            position: "right", // left, center or right
            style: {
                background: "linear-gradient(to right, #00b09b, #96c93d)",
            }
        }).showToast();
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
        Toastify({
            text: "<%= error_msg %>",
            duration: 4000,
            gravity: "top",
            position: "right",
            style: {
                background: "linear-gradient(to right, #ff5f6d, #ffc371)",
            }
        }).showToast();
    <% } %>
</body>
</html>
