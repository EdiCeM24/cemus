<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <%- include('partials/head.ejs') %>
  </head>
  <body class="h-screen container mx-auto">
    <%- include('partials/header.ejs') %>
    <div class="hero min-h-screen bg-base-200">
      <div class="hero-content text-centainer">
        <h1 class="text-5xl font-bold">Message Sent!</h1>
        <p class="py-6">
          Thank you for reaching out! I'll get back to you soon.
        </p>
      </div>
    </div>

    <footer class=""><%- include('partials/footer.ejs') %></footer>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <script>
      // Use EJS output syntax to check if the message array contains elements
      // connect-flash returns an array, so check if length > 0
    </script>
    <% if (success_msg && success_msg.length > 0) { %>
        Toastify({
            text: "<%= success_msg %>",
            duration: 4000,
            gravity: "top", // top or bottom
            position: "right", // left, center or right
            style: {
                background: "linear-gradient(to right, #00b09b, #96c93d)",
            }
        }).showToast();
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
        Toastify({
            text: "<%= error_msg %>",
            duration: 4000,
            gravity: "top",
            position: "right",
            style: {
                background: "linear-gradient(to right, #ff5f6d, #ffc371)",
            }
        }).showToast();
    <% } %>
  </body>
</html>
