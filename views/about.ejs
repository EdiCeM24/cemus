<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
  </head>
<body>
 <!-- Navbar -->
  <header>
    <%- include('includes/header.ejs') %>
  </header>

  <div class="contact-conn container mx-auto max-h-screen mt-[4%] p-10 px-10"> 
    <div class="">
      <% if (success_msg) { %>
        <p class="text-green-600 font-serif font-semibold text-[16px]"><%= success_msg[0] %></p>
      <% } %>
    </div>

    <div class="mb-2 p-1">
      <% if (error_msg) { %>
        <span class="text-rose-600 font-serif font-semibold text-[16px]"><%= error_msg %></span>
      <% } %>
    </div>

    <div class="mb-2 p-1">
      <% if(error) { %>
        <span class="text-rose-600 font-serif font-semibold text-[16px]"><%= error %></span>
      <%}%> 
    </div>
  </div>
  
<div class="flex items-center justify-between flex-col w-full mt-3 p-5">
    <section class="md:flex flex-1 items-center justify-between mt-[1%] mb-[3%] gap-8">
     
      <div class="absolute inset-0">
          <div class="absolute top-20 left-20 w-72 h-72 bg-cyan-500/20 rounded-full blur-3xl"></div>
          <div class="absolute bottom-10 right-10 w-72 h-72 bg-purple-500/20 rounded-full blur-3xl"></div>
      </div>

      <div class="absolute w-[450px] h-[450px] bg-cyan-500/20 rounded-full blur-3xl"></div>

      <div class="flex items-center justify-center flex-col mb-4 flex-1">
        <span class="flex flex-col items-center justify-center leading-tight">
          <span class="flex items-center justify-center gap-2">
            <strong class="mb-3 text-[#eee] text-3xl font-extrabold">Hi,</strong>
            <p class="text-3xl text-[#eee] font-extrabold">I'm</p>
          </span>
          <strong class="text-[#eee] md:text-[2rem] font-extrabold mb-3 tracking-wide flex-wrap">Marcus <span class="md:text-[2rem] font-extrabold text-sky-400 gradient-text tracking-wide">Edidiong</span> Cletus</strong>
          <span class="text-rose-600 text-[23] tracking-wide font-semibold mb-1.5">A Full Stack Developer based in Nigeria</span>

        </span>

        <span class="p-4 md:p-0">
          <p class="tracking-[0.3em] max-w-[450px] text-lg text-white">Studied computer science in the Federal Polytechnic Nekede, Owerri and PGD in view. I'm a creative problem-solver with a keen eye for detail and a love for innovative thinking.</p>
        </span>
        <span class="p-4 md:p-0 mt-4 mb-4">
          <p class="tracking-[0.3em] max-w-[450px] text-lg text-white mb-1">
            I'm a web developer with five (5) years of experience in the industry.
          </p>
          <p class="tracking-[0.3em] max-w-[450px] text-lg text-white">
            My expertise lies in web development, where I have had the opportunity to work on many projects and achieved an excellent.
          </p>
        </span>

        <div class="flex items-center justify-evenly gap-3 mt-3.5">
          <a href="/download-cv" class="bg-sky-400 p-2.5 px-3 grass hover:bg-sky-500 text-slate-950 text-lg font-extrabold rounded-sm cursor-pointer underline-none gap-1.5">
            <button class=" glass flex items-center justify-center gap-[3px] hover:bg-white/10 transition px-5 py-2 rounded-full font-medium">
              <i class="fa-solid fa-download text-white"></i>
              Download CV
            </button>
          </a>
          <button type="button" class="hover:bg-white border-2 border-purple-700 text-white hover:text-slate-950 transition-all duration-200 ease-in-out shadow-md grass p-2.5 px-3 rounded-sm text-[18px] font-extrabold cursor-pointer gap-1.5">
            Hire Me <i class="fa-solid fa-angle-right hover:text-slate-950"></i>
          </button>
        </div>

        <div class="mt-4 flex items-center justify-between gap-3 space-x-2">
          <a href="" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-github text-white flex items-center justify-center object-cover"></i></a>
          <a href="" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-facebook text-white flex items-center justify-center object-cover"></i></a>
          <a href="" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-linkedin text-white flex items-center justify-center object-cover"></i></a>
          <a href="" class="border border-pink-500 rounded-full flex items-center justify-center object-cover w-6 h-6"><i class="fa-brands fa-twitter text-white flex items-center justify-center object-cover"></i></a>
        </div>
      </div>

      <div class="relative glass p-4 rounded-[40px] shadow-2xl shadow-cyan-500/20 w-[400px]">
        <span class="mt-1.5 mb-2 flex-1">
          <img src="/images/cemus_in_suit.jpg" alt="Photo" class="w-[400px] h-[500px] object-cover rounded-[30px]">
          <div class="absolute top-[50%] right-10 opacity-0 hover:opacity-100 transform hover:-translate-x-full transition-all ease-in-out flex items-center justify-center gap-[4%] flex-col bg-slate-300 p-10 rounded space-x-3">
            <a href="+2347024253772" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out">WhatsApp Me</a>
            <a href="" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out">Youtube</a>
            <a href="" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out">fa</a>
            <a href="" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out">fa</a>
          </div>
        </span>
      </div>

      
    </section>

        <!-- About Section -->
      <section id="about" class="py-28 bg-slate-900/50 border-t border-slate-800">

        <div class="max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-2 gap-16 items-center">

          <div>
            <a href="/api/v1/homes/home/#about">
              <h2 class="text-4xl text-white lg:text-5xl font-extrabold mb-8">
                About <span class="gradient-text">Me</span>
              </h2>
            </a>

            <p class="text-slate-300 leading-relaxed text-lg mb-6">
              I specialize in building secure and scalable applications with beautiful user experiences. My focus is creating products that are optimized for performance, maintainability, and business growth.
            </p>

            <p class="text-slate-400 leading-relaxed">
              From backend APIs to frontend experiences, I combine modern development tools with clean architecture to create production-ready solutions.
            </p>
          </div>


          <div class="grid grid-cols-2 gap-6">

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 text-xl font-bold mb-4">Frontend</h3>
              <p class="text-slate-300">React.js, Next.js, TailwindCSS, Redux</p>
            </div>

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 text-xl font-bold mb-4">Backend</h3>
              <p class="text-slate-300">Node.js, Express.js, Python, Django, fastAPI, REST APIs, GraphQL, grpc</p>
            </div>

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 text-xl font-bold mb-4">Database</h3>
              <p class="text-slate-300">PostgreSQL, MySQL, MongoDB, using Sequelize, Mongoose & Prisma (ORM)</p>
            </div>

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 text-xl font-bold mb-4">Deployment</h3>
              <p class="text-slate-300">Docker, AWS, CI/CD, Production Hosting</p>
            </div>

          </div>

        </div>
      </section>
  </div>
   <div class="contact_form mb-5 p-10 transform-cpu transition-shadow">
     <strong class="contact_form_heading flex text-center justify-center text-2xl font-serif font-semibold text-[#eee] mt-3 mb-3">Hire Me</strong>
      <i class="fa fa-times cursor-pointer text-xl font-bold" aria-hidden="true" id="contact-cancel"></i>
      <div class="cont_form_container w-full flex items-center justify-center">
        <form action="/api/v1/contacts/contact" method="POST" class="contact-form flex items-center justify-center py-4 px-6">
          <div class="contact_form_contents w-full items-center justify-center">
            <div class="contact_form_control w-ful mt-3 mb-3 gap-4">
              <input type="text" name="name" id="name" placeholder="Your full name" class="w-ful text-black text-xl font-semibold font-serif p-2 mb-3 px-3 border-none outline-none rounded-sm" required autocomplete="off" autofocus>
              <input type="email" name="email" id="email" placeholder="Your Email" class="w-ful text-black text-xl font-semibold font-serif p-2 mt-1 px-3 border-none outline-none rounded-sm" required autocomplete="off" autofocus>
            </div>
            <div class="contact_form_control w-ful mt-3 mb-3 gap-4">
              <input type="url" name="website" id="website" class="w-ful text-black text-xl font-semibold font-serif p-2 mb-3 px-3 border-none outline-none rounded-sm" placeholder="Your Website" required autocomplete="off" autofocus>
              <input type="text" name="company" id="company" class="w-ful text-black text-xl font-semibold font-serif p-2 mt-1 px-3 border-none outline-none rounded-sm" placeholder="Your Company" required autocomplete="off" autofocus>
            </div>
            <div class="contact_form_control md:flex items-center justify-between w-ful mt-4 mb-4">
              <input type="text" name="subject" id="subject" class="w-ful text-black text-xl font-semibold font-serif p-2 px-3 border-none outline-none rounded-sm" placeholder="Your Subject" required autocomplete="off" autofocus>
              <section class="flex items-center justify-center gap-3 ml-2">
                <span class="flex items-center justify-evenly gap-1">
                  <input type="radio" name="activity" value="freelance" id="freelance" required>
                  <label for="" class="text-white font-medium text-[15px]">Freelance</label>
                </span>
                <span class="flex items-center justify-evenly gap-1">
                  <input type="radio" name="activity" value="remote" id="remote" required>
                  <label for="" class="text-white font-semibold text-lg">Remote</label>
                </span>
                <span class="flex items-center justify-evenly gap-1">
                  <input type="radio" name="activity" value="on_site" id="on_site" required>
                  <label for="" class="text-white font-semibold text-lg">On_site</label>
                </span>
              </section>
            </div>
            <div class="contact_form_control w-ful mt-4 mb-3">
              <textarea name="message" id="message" class="w-ful text-black text-xl font-semibold font-serif p-2 px-3 border-none outline-none rounded-sm" cols="30" rows="4" placeholder="Your message" required autocomplete="off" autofocus></textarea>
            </div>
    
            <button type="submit" class="w-ful cursor-pointer p-2 px-3 text-white text-xl font-semibold font-serif border-none outline-none rounded-sm bg-cyan-800 hover:bg-cyan-900 transition duration-200 ease-in-out">Contact Me</button>
          </div>
        </form>
      </div>
   </div>

  <div class="p-5 px-5 mt-[0%] fixed left-[0%] top-[0%]">
    <div class=" md:mt-[20%] mt-[80%]  ">
      
      <div ">
        <form action="" method="POST">
            <!-- <input type="hidden" name="" value=""/> -->
          
        </form>
      </div>
    </div>
  </div>

  <footer>
    <%- include('partials/footer.ejs') %>
  </footer>
  <script src="/script/contactForm.js"></script>
</body>
</html>




