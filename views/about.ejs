        </div>

      </div>

      <div class="relative glass p-4 rounded-[40px] shadow-2xl shadow-cyan-500/20 md:w-[300px] w-[400px]">
        <span class="relative mt-1.5 mb-2 flex-1">
          <img src="/images/cemus_in_suit.jpg" alt="Photo" class="md:w-[300px] w-[400px] h-[500px] object-cover rounded-[30px]">
          <div class="absolute top-[50%] right-10 hover:bg-opacity-50 transition-transform duration-300 scale-0 hover:scale-100 ease-in-out flex items-center justify-center gap-[4%] flex-col bg-slate-300 p-10 rounded space-x-3">
            <a href="+2347024253772" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out rounded-full w-10 h-10">WhatsApp Me</a>
            <a href="" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out rounded-full w-10 h-10">Youtube</a>
            <a href="" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out rounded-full w-10 h-10">fa</a>
            <a href="" class="hover:opacity-100 translate-x-0 hover:-translate-x-5 transition-all duration-200 ease-in-out rounded-full w-10 h-10">fa</a>
          </div>
          
        </span>
      </div>

      
    </section>

        <!-- About Section -->
      <section id="about" class="py-28 bg-slate-900/50 border-t border-slate-800">

        <div class="max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-2 gap-16 items-center">

          <div>
            <a href="/api/v1/homes/home/#about">
              <h2 class="text-4xl text-white lg:text-5xl font-extrabold mb-8">
                About <span class="gradient-text">Me</span>
              </h2>
            </a>

            <p class="text-slate-300 leading-relaxed text-lg mb-6">
              I specialize in building secure and scalable applications with beautiful user experiences. My focus is creating products that are optimized for performance, maintainability, and business growth.
            </p>

            <p class="text-slate-400 leading-relaxed">
              From backend APIs to frontend experiences, I combine modern development tools with clean architecture to create production-ready solutions.
            </p>
          </div>


          <div class="grid grid-cols-2 gap-6">

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 text-xl font-bold mb-4">Frontend</h3>
              <p class="text-slate-300">React.js, Next.js, TailwindCSS, Redux</p>
            </div>

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 text-xl font-bold mb-4">Backend</h3>
              <p class="text-slate-300">Node.js, Express.js, Python, Django, fastAPI, REST APIs, GraphQL, grpc</p>
            </div>

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 text-xl font-bold mb-4">Database</h3>
              <p class="text-slate-300">PostgreSQL, MySQL, MongoDB, using Sequelize, Mongoose & Prisma (ORM)</p>
            </div>

            <div class="glass rounded-3xl p-8">
              <h3 class="text-cyan-400 md:text-xl text-lg md:ml-0 -ml-5 font-bold mb-4">Deployment</h3>
              <p class="text-slate-300">Docker, AWS, CI/CD, Production Hosting</p>
            </div>

          </div>

        </div>
      </section>
  </div>
  <div class="container mx-auto w-full h-screen flex flex-col items-center justify-center mb-5">
    <form action="/api/v1/homes/about" method="POST" class="flex-1 items-center relative overflow-hidden">
      <div class="popup z-20 p-3 shadow-lg px-10 bg-opacity-75 transition-opacity overflow-y-auto" id="popup">
        <div class="flex items-center justify-between mb-3">
          <p class="text-gray-300 text-[14px] font-normal">For reaching out to me; you can contact me.</p>
          <button type="button" id="closePopup" class="text-gray-300 flex items-center justify-center text-2xl font-bold">&times;</button>
        </div>
        <div class="flex justify-center items-center flex-col gap-2.5 w-full">
          <input type="text" name="name" class="w-full p-2 rounded-[4px] bg-transparent border-t-0 border-l-0 border-r-0 border-b-2 text-gray-300 text-xl font-medium outline-none" placeholder="Enter name" required autocomplete="off">
          <input type="email" name="email" class="w-full p-2 rounded-[4px] bg-transparent border-t-0 border-l-0 border-r-0 border-b-2 text-gray-300 text-xl font-medium outline-none" placeholder="Enter email" required autocomplete="off">
          <input type="tel" name="phoneNumber" class="w-full p-2 rounded-[4px] bg-transparent border-t-0 border-l-0 border-r-0 border-b-2 text-gray-300 text-xl font-medium outline-none" placeholder="Enter phone number" required autocomplete="off">
          <input type="text" name="company" class="w-full p-2 rounded-[4px] bg-transparent border-t-0 border-l-0 border-r-0 border-b-2 text-gray-300 text-xl font-medium outline-none" placeholder="Enter company name" required autocomplete="off">
          <input type="url" name="website" class="w-full p-2 rounded-[4px] bg-transparent border-t-0 border-l-0 border-r-0 border-b-2 text-gray-300 text-xl font-medium outline-none" placeholder="Enter company website" required autocomplete="off">
          <input type="text" name="subject" class="w-full p-2 rounded-[4px] bg-transparent border-t-0 border-l-0 border-r-0 border-b-2 text-gray-300 text-xl font-medium outline-none" placeholder="Enter your subject" required autocomplete="off">
        </div>
        <div class="md:flex items-center md:mt-2 md:mb-2 mt-3 mb-3 gap-2 w-full">
          <span class="flex items-center gap-1">
            <input type="radio" name="service" value="freelance" class="" required>
            <label for="" class="text-gray-300 text-[13px] font-medium">Freelance</label>
            <input type="radio" name="service" value="remote" class="" required>
            <label for="" class="text-gray-300 text-[13px] font-medium">Remote</label>
            <input type="radio" name="service" value="onSite" class="" required>
            <label for="" class="text-gray-300 text-[13px] font-medium whitespace-nowrap">On site</label>
          </span>

          <select name="budget" id="" class="outline-none bg-sky-950 text-white p-4 rounded-[4px]" required>
            <option>Weekly Budget</option>
            <option value="1">$1000 - 1500</option>
            <option value="2">$1500 - 2000</option>
            <option value="3">$2000 - 2500</option>
            <option value="4">$2500 - 3000</option>
            <option value="5">$3000 - 4000</option>
            <option value="6">$4000+</option>
          </select>
        </div>

        <div class="mt-2 mb-2">
        <textarea name="message" class="w-full bg-slate-800 text-gray-300 rounded-[4px] outline-none border-2 hover:border-sky-600" id="" cols="20" rows="5" required></textarea>
        </div>
  
        <div class="">
        <button type="submit" class="btn btn-outline btn-ghost text-[#3C5077] py-[10px] px-[60px] border-0 cursor-pointer text-[25px] font-semibold rounded-[30px]">Contact Me</button>
        </div>
      </div>

    </form>
  </div>

  <div class="p-5 px-5 mt-[0%] fixed left-[0%] top-[0%]">
    <div class=" md:mt-[20%] mt-[80%]  ">
      
      <div ">
        <form action="" method="POST">
            <!-- <input type="hidden" name="" value=""/> -->
          
        </form>
      </div>
    </div>
  </div>

  <footer>
    <%- include('partials/footer.ejs') %>
  </footer>
  <script src="/script/about.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

  <script>
      // Use EJS output syntax to check if the message array contains elements
      // connect-flash returns an array, so check if length > 0
    </script>
    <div class="">
      <% if (success_msg && success_msg.length > 0) { %>
          Toastify({
              text: "<%= success_msg %>",
              duration: 4000,
              gravity: "top", // top or bottom
              position: "right", // left, center or right
              style: {
                  background: "linear-gradient(to right, #00b09b, #96c93d)",
              }
          }).showToast();
      <% } %>

      <% if (error_msg && error_msg.length > 0) { %>
          Toastify({
              text: "<%= error_msg %>",
              duration: 4000,
              gravity: "top",
              position: "right",
              style: {
                  background: "linear-gradient(to right, #ff5f6d, #ffc371)",
              }
          }).showToast();
      <% } %>
    </div>
</body>
</html>




