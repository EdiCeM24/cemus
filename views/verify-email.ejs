<!DOCTYPE html>
<html>
  <head>
    <title><%- title %></title>
    <link rel="stylesheet" href="/css/output.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@ionic/core/css/ionic.bundle.css"
    />
  </head>

  <body class="font-[Arial] p-[30px] bg-[#f5f5f5]">
    <div class="container bg-white p-[30px] rounded-[10px]">
      <h2 class="text-[#2563eb]">Hello <%= user.username %></h2>

      <p>This verification link expires in 20 minutes.</p>

      <h1>You're Almost There!</h1>
      <strong>
        <p>We’ve sent you an email with your activation link.</p>
        Please follow the steps to activate your account and gain full access to
        all features of our website.
      </strong>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <footer><%- include('partials/footer.ejs') %></footer>
  </body>
</html>
